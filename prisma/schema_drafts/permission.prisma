model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  resource    String
  action      String
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([resource, action])
  @@map("permissions")
}
