{
  "info": {
    "name": "School SaaS API - Users Module",
    "_postman_id": "b1e77f0d-e591-4d7a-8f19-b6908a9f4c12",
    "description": "Postman Collection for School Management SaaS API. Includes complete Users module with Create, Paginated List, Get by ID, Update, Change Password, Toggle Status, and Soft Delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your-jwt-auth-token-here",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "replace-with-user-uuid",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "1. Create New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Raju Kumar\",\n  \"email\": \"raju@example.com\",\n  \"password\": \"password123\",\n  \"phoneNumber\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/create-new-user",
              "host": ["{{baseUrl}}"],
              "path": ["users", "create-new-user"]
            },
            "description": "Registers a new user record in the database."
          },
          "response": []
        },
        {
          "name": "2. Get All Users (Paginated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/get-all-users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["users", "get-all-users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieves paginated non-deleted users list."
          },
          "response": []
        },
        {
          "name": "3. Get User By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/get-user",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "get-user"]
            },
            "description": "Retrieves user details by their UUID."
          },
          "response": []
        },
        {
          "name": "4. Update User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Raju Kumar Updated\",\n  \"phoneNumber\": \"+919876543211\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/update-user",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "update-user"]
            },
            "description": "Updates non-sensitive profile details for a user."
          },
          "response": []
        },
        {
          "name": "5. Change Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newSecretPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "change-password"]
            },
            "description": "Validates currentPassword and updates to newPassword."
          },
          "response": []
        },
        {
          "name": "6. Toggle Active Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/toggle-status",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "toggle-status"]
            },
            "description": "Activates (true) or deactivates (false) user account."
          },
          "response": []
        },
        {
          "name": "7. Soft Delete User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/delete-user",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "delete-user"]
            },
            "description": "Soft deletes user (isDeleted: true, isActive: false, deletedAt timestamp)."
          },
          "response": []
        }
      ]
    }
  ]
}
